# Copy to .env and fill in. NEVER commit .env.
# --- Hugging Face (read for gated models, write for push) ---
HF_TOKEN=
# where model weights are cached: put it on the BIG disk. HyperStack: /ephemeral/hf-cache ; RunPod/Vast.ai: /workspace/hf-cache
HF_HOME=/ephemeral/hf-cache
# --- Synthetic data: any OpenAI-compatible provider (e.g. Euron). Base URL must end with /v1 or the provider's equivalent.
OPENAI_BASE_URL=
OPENAI_API_KEY=
SYNTH_MODEL=
# --- Tracing / logging (optional) ---
LANGSMITH_API_KEY=
WANDB_API_KEY=
# --- Serving ---
VLLM_API_KEY=change-me-long-random
UPSTREAMS=http://127.0.0.1:8000
UPSTREAM_API_KEY=change-me-long-random
GATEWAY_KEY_HASHES=
GATEWAY_ADMIN_KEY_HASH=
RATE_LIMIT_RPM=60
# --- Object storage (FakeCloud locally: http://localhost:4566 ; real AWS: leave empty) ---
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
# --- Hyperstack autoscaler (optional) ---
HYPERSTACK_API_KEY=
GATEWAY_ADMIN_KEY=
